# Which environment image vime runs in, and what provisioning installs.
# Framework knowledge, so it lives with the integration - see
# integrations/verl/environments.env for why.

# vime image (Ray head; vime's layout puts the GPUs on the head). Pin a specific
# tag in production.
ENGINE_vllm_IMAGE=inferactinc/public:vime-latest
ENGINE_vllm_PY_MODULE=vllm
ENGINE_vllm_MIN_VERSION=
# CuMemAllocator (sleep/wake) is incompatible with expandable_segments.
ENGINE_vllm_ALLOC_CONF=expandable_segments:False

# Cloned and installed at provisioning time, like verl. vime additionally needs
# Megatron-LM at this tag.
VIME_REPO=https://github.com/vllm-project/vime.git
VIME_REF=main
MEGATRON_REF=core_v0.16.0
