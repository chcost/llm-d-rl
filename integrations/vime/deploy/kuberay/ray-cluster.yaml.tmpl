apiVersion: ray.io/v1
kind: RayCluster
metadata:
  name: vime-cluster
  namespace: ${NAMESPACE}
spec:
  rayVersion: '2.56.1'

  # Single-pod layout: head owns all GPUs. Avoids the two-pod split where
  # vLLM's import-time CUDA check fails on a CPU-only head.

  headGroupSpec:
    rayStartParams:
      num-cpus: "16"
      num-gpus: "6"
    template:
      spec:
        initContainers:
        - name: fetch-binaries
          image: ${IMG_CRANE}
          command: ["/busybox/sh", "-c"]
          args:
          - |
            set -e
            /ko-app/crane export --platform linux/amd64 "$EPP_IMAGE"   - | /busybox/tar -xOf - app/epp             > /opt/llm-d-bins/epp
            /ko-app/crane export --platform linux/amd64 "$ENVOY_IMAGE" - | /busybox/tar -xOf - usr/local/bin/envoy > /opt/llm-d-bins/envoy
            chmod +x /opt/llm-d-bins/epp /opt/llm-d-bins/envoy
          env:
          - name: EPP_IMAGE
            value: "${IMG_EPP}"
          - name: ENVOY_IMAGE
            value: "${IMG_ENVOY}"
          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins

        containers:
        - name: ray-head
          image: ${IMG_VIME}
          imagePullPolicy: Always
          workingDir: /tmp
          livenessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 30
            periodSeconds: 5
            failureThreshold: 10
          readinessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 10
            periodSeconds: 5
            failureThreshold: 5
          lifecycle:
            postStart:
              exec:
                command:
                - /bin/bash
                - -c
                - |
                  exec > /tmp/setup_log.txt 2>&1
                  set -euxo pipefail
                  export PATH="/tmp/.local/bin:$PATH"
                  echo "=== vime setup ==="

                  git clone --depth=1 https://github.com/vllm-project/vime.git /tmp/vime
                  pip install --no-deps -e /tmp/vime

                  git clone --depth=1 -b core_v0.16.0 https://github.com/NVIDIA/Megatron-LM.git /tmp/Megatron-LM
                  mkdir -p /tmp/pyfix
                  printf 'import sys\nclass _S:\n def __init__(self,f):self._f=f\n def find_spec(self,*a,**k):\n  try:return self._f.find_spec(*a,**k)\n  except(PermissionError,OSError):return None\nsys.meta_path[:]=[_S(f) if "editable" in getattr(type(f),"__module__","") else f for f in sys.meta_path]\n' > /tmp/pyfix/sitecustomize.py

                  # Install the common package (provides llm-d-rl-router and llm-d-registration-shim).
                  # Fail loudly: set -e aborts before the ready marker if the install fails,
                  # and the import check turns a silent empty install into a hard postStart
                  # error (container restarts) instead of a pod that looks ready but is broken.
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/llm-d-incubation/llm-d-rl.git#subdirectory=integrations/common"
                  python3 -c "import llm_d_rl_common" || { echo "FATAL: common package not importable after install"; exit 1; }
                  command -v llm-d-rl-router > /dev/null || { echo "FATAL: llm-d-rl-router not on PATH after installing common"; exit 1; }

                  # Pre-create empty endpoints file so EPP's file-discovery plugin
                  # can watch it from the start (EPP crashes if the file is absent).
                  printf 'endpoints: []\n' > /tmp/epp-endpoints.yaml

                  # llm-d-rl-router (llm_d_rl_common.cli, installed above) starts EPP
                  # and Envoy with the flags the whole repo shares - including
                  # --allow-experimental-plugins, which epp-config.yaml's
                  # burst-prefix-cache-producer needs or EPP refuses to load the
                  # config. It finds the crane-extracted binaries via
                  # LLMD_EPP_BINARY / LLMD_ENVOY_BINARY (set in env below), waits for
                  # each to accept connections, and exits if either one dies.
                  nohup llm-d-rl-router \
                    --epp-config /etc/llmd-configs/epp-config.yaml \
                    --envoy-config /etc/llmd-configs/envoy.yaml \
                    >> /tmp/router.log 2>&1 &

                  nohup llm-d-registration-shim \
                    --engine-type vllm \
                    --host 127.0.0.1 --port 3001 \
                    --endpoints-file /tmp/epp-endpoints.yaml \
                    > /tmp/shim.log 2>&1 &

                  # EPP/Envoy/shim are up. Model download and training are
                  # handled by run-qwen3-4B.sh (run manually from the head pod).
                  echo "Setup complete" > /tmp/vime_ready.txt

          env:
          - name: HOME
            value: "/tmp"
          - name: USER
            value: "ray"
          - name: PYTHONPATH
            value: "/tmp/pyfix:/tmp/Megatron-LM"
          - name: MY_POD_IP
            valueFrom:
              fieldRef:
                fieldPath: status.podIP
          - name: HF_HOME
            value: "/tmp/vime/hf_cache"
          - name: HF_DATASETS_CACHE
            value: "/tmp/vime/hf_cache/datasets"
          - name: XDG_CACHE_HOME
            value: "/tmp/vime/hf_cache"
          - name: HUGGINGFACE_HUB_CACHE
            value: "/tmp/vime/hf_cache"
          - name: TRITON_CACHE_DIR
            value: "/tmp/triton"
          - name: FLASHINFER_WORKSPACE_DIR
            value: "/tmp/flashinfer"
          - name: TORCHINDUCTOR_CACHE_DIR
            value: "/tmp/torch_inductor_cache"
          - name: VLLM_TARGET_DEVICE
            value: "cuda"
          - name: TOKENIZERS_PARALLELISM
            value: "false"
          - name: OMP_NUM_THREADS
            value: "1"
          - name: RAY_max_grpc_threads
            value: "32"
          - name: NCCL_DEBUG
            value: "INFO"
          - name: WANDB_MODE
            value: "offline"
          # --- EPP / Envoy binary paths (filled by the fetch-binaries init container) ---
          # Read by llm_d_rl_common.router_stack, which llm-d-rl-router uses to launch
          # them; neither binary is baked into the image, so bumping IMG_EPP /
          # IMG_ENVOY in deploy.env and recreating the pod is the whole upgrade path.
          - name: LLMD_EPP_BINARY
            value: "/opt/llm-d-bins/epp"
          - name: LLMD_ENVOY_BINARY
            value: "/opt/llm-d-bins/envoy"

          # --- Router verbosity (default: quiet) ---
          # See deploy/kuberay/README.md ## Increasing verbosity.
          # - name: LLMD_EPP_VERBOSITY
          #   value: "5"
          # - name: LLMD_ENVOY_LOG_LEVEL
          #   value: "debug"

          resources:
            limits:
              cpu: "32"
              memory: "256G"
              nvidia.com/gpu: "6"
            requests:
              cpu: "16"
              memory: "128G"
              nvidia.com/gpu: "6"

          ports:
          - containerPort: 6379
            name: gcs-server
          - containerPort: 8265
            name: dashboard
          - containerPort: 10001
            name: client
          - containerPort: 8081
            name: envoy

          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
          - mountPath: /dev/shm
            name: dshm
          - mountPath: /etc/llmd-configs
            name: llmd-epp-configs-vime
            readOnly: true
          - mountPath: /.cache
            name: vllm-cache
          - mountPath: /.triton
            name: triton-cache

        volumes:
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "64Gi"
        - name: llmd-epp-configs-vime
          configMap:
            name: llmd-epp-configs-vime
        - name: llm-d-bins
          emptyDir: {}
        - name: vllm-cache
          emptyDir: {}
        - name: triton-cache
          emptyDir: {}
