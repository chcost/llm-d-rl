# Deployment config for the KubeRay example. Single source of truth for every
# runtime image.
#
# deploy/deploy.sh sources this file to render ray-cluster.yaml.tmpl (envsubst)
# and to create the ConfigMap. Edit image values here, not in the manifest.
#
# The target namespace is deliberately NOT set here - it is per-user and comes
# from the NAMESPACE environment variable (export NAMESPACE=...). deploy.sh and
# the helper scripts fail fast when it is unset, so a personal namespace never
# gets committed to this file.

# --- Runtime images -----------------------------------------------------------
# IMG_EPP / IMG_ENVOY / IMG_SIDECAR are NOT set here: they belong with the configs
# they must match, in llm_d_rl_common/configs/versions.env, which deploy.sh sources
# first. Override one here only if this framework genuinely needs a different build.
# The IMG_* names are deliberately distinct from the container-runtime
# $EPP_IMAGE / $ENVOY_IMAGE env vars the crane init container reads, so the
# scoped envsubst in deploy.sh only rewrites these and never touches the crane
# command args.

# verl image (Ray head + workers). Currently the nightly-vLLM testing image, built from
# deploy/Dockerfile.verl.vllm-p2p (see deploy/README.md's "Nightly-vLLM environment image"
# section). Also bakes in NIXL + the vLLM patches PD and P2P KV-cache sharing both need,
# so this same image covers every mode - native/epp/epp-p2p/PD.
#IMG_VERL=verlai/verl:vllm018.dev1
IMG_VERL=ghcr.io/llm-d-incubation/llm-d-rl/verl:vllm-p2p

# verl image for the SGLang engine. Stock verl org environment image with SGLang
# preinstalled; verl itself is still installed fresh at postStart (see
# deploy/README.md), same as every other mode. No custom Dockerfile - EPP-direct-gRPC
# routing needs nothing SGLang doesn't already ship.
IMG_VERL_SGLANG=verlai/verl:sgl0512.dev3

# --- verl source --------------------------------------------------------------
# The verlai/verl images are ENVIRONMENT images (vLLM/CUDA/torch, no verl), so
# postStart clones verl and checks this ref out on the head and every worker.
# Any git ref works, but prefer a full SHA: head and workers clone independently,
# so a branch name can install two different commits in one cluster. postStart
# echoes the resolved SHA per pod - compare them before trusting a branch run.
VERL_COMMIT=060bebc565e07b0341465894716b92ac0903f6e1

# --- Per-engine settings -----------------------------------------------------
# One ray-cluster.yaml.tmpl serves both engines; deploy.sh picks a column from
# here with --engine (default vllm) and exports it as IMG_TRAINER /
# ENGINE_PY_MODULE / ENGINE_HEAD_NUM_CPUS / ENGINE_ALLOC_CONF. To add an engine,
# add a column - not a manifest. The rationale for each value is in the manifest
# at the point of use.
ENGINE_vllm_IMAGE="$IMG_VERL"
ENGINE_vllm_PY_MODULE=vllm
ENGINE_vllm_HEAD_NUM_CPUS=4
ENGINE_vllm_ALLOC_CONF=expandable_segments:False

ENGINE_sglang_IMAGE="$IMG_VERL_SGLANG"
ENGINE_sglang_PY_MODULE=sglang
ENGINE_sglang_HEAD_NUM_CPUS=0
ENGINE_sglang_ALLOC_CONF=

# Generic registry tool pinned by digest (go-containerregistry crane :debug,
# which ships /busybox/sh + /busybox/tar). Never rebuilt.
IMG_CRANE=gcr.io/go-containerregistry/crane@sha256:1b1fb24d2b1bb27a9daf81a588157e68463876904e8e537a812edba6284fb252




# Search-R1 BM25 retrieval server (agentic searchr1 task only). Built from
# deploy/Dockerfile.searchr1-retriever. CPU-only; runs as its own Deployment+Service
# (deploy/retriever.yaml.tmpl), applied by `deploy.sh retriever`.
IMG_RETRIEVER=ghcr.io/ezrasilvera/searchr1-retriever:bm25
