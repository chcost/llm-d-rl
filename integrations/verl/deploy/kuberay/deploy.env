# Platform config for this KubeRay deployment.
#
# Only values that belong to the CLUSTER live here. Two other files are sourced
# before this one, and this file may override either:
#
#   llm_d_rl_common/configs/versions.env   the routing stack (EPP / Envoy /
#                                          sidecar images and required flags),
#                                          stored beside the configs they match
#   ../../environments.env                 which environment image and which verl
#                                          commit go together, plus the engine
#                                          columns --engine picks from
#
# The target namespace is deliberately NOT set here - it is per-user and comes
# from the NAMESPACE environment variable (export NAMESPACE=...). deploy.sh and
# the helper scripts fail fast when it is unset, so a personal namespace never
# gets committed.

# Generic registry tool pinned by digest (go-containerregistry crane :debug,
# which ships /busybox/sh + /busybox/tar). Never rebuilt.
IMG_CRANE=gcr.io/go-containerregistry/crane@sha256:1b1fb24d2b1bb27a9daf81a588157e68463876904e8e537a812edba6284fb252

# Search-R1 BM25 retrieval server (agentic searchr1 task only). CPU-only; runs as
# its own Deployment+Service, applied by `deploy.sh retriever`.
IMG_RETRIEVER=ghcr.io/ezrasilvera/searchr1-retriever:bm25
