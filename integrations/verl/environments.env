# Which environment image and which verl commit go together.
#
# This is framework knowledge, not platform knowledge, so it lives with the
# integration rather than in a cluster manifest's deploy.env. The reason is a
# scar: the old verl pin declared vllm>=0.8.5,<=0.12.0 while the image shipped
# 0.26.1rc1, and runs only worked at all because the install passes --no-deps.
# Nothing checked, because the constraint and the image were declared in
# different places. The provisioning script asserts them against each other now.
#
# Sourced by a deployment before its own platform config, so a cluster can
# override any of it locally.

# --- verl source --------------------------------------------------------------
# The verlai/verl images are ENVIRONMENT images (vLLM/CUDA/torch, no verl - the
# Dockerfile installs verl only to resolve its dependency closure and then
# uninstalls it), so verl is cloned and installed at provisioning time.
# Any git ref works, but prefer a full SHA: nodes clone independently, so a
# branch name can install two different commits in one cluster.
VERL_COMMIT=060bebc565e07b0341465894716b92ac0903f6e1

# --- Engines this framework is known to work with -----------------------------
# One manifest serves every engine; a deployment picks a column with --engine and
# exports it as IMG_TRAINER / ENGINE_PY_MODULE / ENGINE_HEAD_NUM_CPUS /
# ENGINE_ALLOC_CONF. To add an engine, add a column - not a manifest.
#
# ENGINE_<name>_MIN_VERSION is what provisioning checks the installed engine
# against, so an image that predates the verl pin's requirement fails loudly
# instead of silently.

# vLLM: the nightly testing image built from images/Dockerfile.verl.vllm-p2p. It
# also bakes in NIXL and the vLLM patches PD and P2P KV-cache sharing need, so
# one image covers native / epp / epp-p2p / PD.
#   HEAD_NUM_CPUS=4 so Ray can schedule the driver on the head, which has the RAM
#   for the dataloader and the validation batch.
#   ALLOC_CONF: CuMemAllocator (sleep/wake) is incompatible with
#   expandable_segments, so it must be False.
ENGINE_vllm_IMAGE=ghcr.io/llm-d-incubation/llm-d-rl/verl:vllm-p2p
ENGINE_vllm_PY_MODULE=vllm
ENGINE_vllm_MIN_VERSION=0.18.0
ENGINE_vllm_HEAD_NUM_CPUS=4
ENGINE_vllm_ALLOC_CONF=expandable_segments:False

# SGLang: stock verl org environment image with SGLang preinstalled. No custom
# Dockerfile - EPP direct-gRPC routing needs nothing SGLang does not ship.
#   HEAD_NUM_CPUS=0 so Ray never schedules a generic actor on the GPU-less head:
#   importing SGLangReplica needs libcuda.so.1 and would crash there.
#   ALLOC_CONF empty, which torch parses as no options.
ENGINE_sglang_IMAGE=verlai/verl:sgl0512.dev3
ENGINE_sglang_PY_MODULE=sglang
ENGINE_sglang_MIN_VERSION=
ENGINE_sglang_HEAD_NUM_CPUS=0
ENGINE_sglang_ALLOC_CONF=

# vLLM 0.18.0: stock verlai/verl environment image, NOT the nightly vllm-p2p one
# above. Needed for the GV4.1 (Granite-Vision) fork (see VERL_REPO_URL/VERL_COMMIT
# overrides in a GV4.1-specific deploy.env or CLI env) - that fork's patches (FSDP
# wrap policy, vLLM model registration for a custom out-of-tree architecture) were
# written and validated against vLLM 0.18.0 specifically; verl's own code at this
# vintage has zero branches past vLLM 0.17.0, so the newer nightly wheel the
# vllm_IMAGE column ships is a real compat risk, not just an unused ceiling.
#   HEAD_NUM_CPUS/ALLOC_CONF: same rationale as ENGINE_vllm_* above (unrelated to
#   which vLLM version, just the same colocated-head-driver topology).
ENGINE_vllm018_IMAGE=verlai/verl:vllm018.dev1
ENGINE_vllm018_PY_MODULE=vllm
ENGINE_vllm018_MIN_VERSION=0.18.0
ENGINE_vllm018_HEAD_NUM_CPUS=4
ENGINE_vllm018_ALLOC_CONF=expandable_segments:False
