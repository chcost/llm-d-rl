# Deployment config for the slime KubeRay example.
# Single source of truth for every runtime image.
#
# deploy.sh sources this file to render ray-cluster.yaml.tmpl (envsubst)
# and to create the ConfigMap. Edit image values here, not in the manifest.
#
# NAMESPACE is deliberately NOT set here — it is per-user and comes from the
# environment (export NAMESPACE=...). deploy.sh fails fast when it is unset.

# --- Runtime images ----------------------------------------------------------

# Slime image (Ray head + workers). Published as slimerl/slime.
# Pin to a specific tag in production; :latest works for development.
IMG_SLIME=slimerl/slime:latest

# Generic registry tool pinned by digest (go-containerregistry crane :debug,
# which ships /busybox/sh + /busybox/tar). Never rebuilt.
IMG_CRANE=gcr.io/go-containerregistry/crane@sha256:1b1fb24d2b1bb27a9daf81a588157e68463876904e8e537a812edba6284fb252

# EPP image: fetch-binaries extracts /app/epp from here at pod start.
# Must include sglanghttp-parser (the public llm-d EPP image does not yet).
IMG_EPP=<epp-image-with-sglanghttp-parser>

# Envoy image: fetch-binaries extracts /usr/local/bin/envoy from here.
IMG_ENVOY=docker.io/envoyproxy/envoy:distroless-v1.33.2

# Override the burst EPP parser (deploy.sh defaults to vllmhttp-parser).
EPP_PARSER=sglanghttp-parser
