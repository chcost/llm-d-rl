apiVersion: ray.io/v1
kind: RayCluster
metadata:
  name: slime-cluster
  namespace: ${NAMESPACE}
spec:
  rayVersion: '2.56.1'

  # Single-pod layout: head owns all GPUs. Avoids the two-pod split where
  # the head has no GPU and cannot run convert_hf_to_torch_dist.py to produce
  # the Megatron torch_dist checkpoint required by --ref-load.

  headGroupSpec:
    rayStartParams:
      num-cpus: "16"
      num-gpus: "6"
    template:
      spec:
        # EPP and Envoy are not in the slime image. The fetch-binaries init
        # container pulls them from their separate (public) images using crane
        # and extracts the binaries into the llm-d-bins emptyDir volume.
        # Bump IMG_EPP / IMG_ENVOY in deploy.env to change versions without
        # rebuilding the slime image.
        initContainers:
        - name: fetch-binaries
          image: ${IMG_CRANE}
          command: ["/busybox/sh", "-c"]
          args:
          - |
            set -e
            /ko-app/crane export --platform linux/amd64 "$EPP_IMAGE"   - | /busybox/tar -xOf - app/epp             > /opt/llm-d-bins/epp
            /ko-app/crane export --platform linux/amd64 "$ENVOY_IMAGE" - | /busybox/tar -xOf - usr/local/bin/envoy > /opt/llm-d-bins/envoy
            chmod +x /opt/llm-d-bins/epp /opt/llm-d-bins/envoy
          env:
          - name: EPP_IMAGE
            value: "${IMG_EPP}"
          - name: ENVOY_IMAGE
            value: "${IMG_ENVOY}"
          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins

        containers:
        - name: ray-head
          image: ${IMG_SLIME}   # slimerl/slime:<version> — see deploy.env
          imagePullPolicy: Always
          workingDir: /tmp   # Ray multiprocessing.spawn restores cwd; /root may be permission-denied
          livenessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 30
            periodSeconds: 5
            failureThreshold: 10
          readinessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 10
            periodSeconds: 5
            failureThreshold: 5
          lifecycle:
            postStart:
              exec:
                command:
                - /bin/bash
                - -c
                - |
                  exec > /tmp/setup_log.txt 2>&1
                  export PATH="/tmp/.local/bin:$PATH"
                  export PIP_BREAK_SYSTEM_PACKAGES=1
                  echo "=== slime setup starting (background) ==="
                  nohup bash -s >> /tmp/setup_log.txt 2>&1 <<'SETUP' &
                  set -euxo pipefail
                  export PATH="/tmp/.local/bin:$PATH"
                  export PIP_BREAK_SYSTEM_PACKAGES=1
                  git clone --depth=1 https://github.com/THUDM/slime.git /tmp/slime-src
                  git clone --depth=1 -b core_v0.16.0 https://github.com/NVIDIA/Megatron-LM.git /tmp/Megatron-LM
                  mkdir -p /tmp/pyfix
                  printf 'import sys\nclass _S:\n def __init__(self,f):self._f=f\n def find_spec(self,*a,**k):\n  try:return self._f.find_spec(*a,**k)\n  except(PermissionError,OSError):return None\nsys.meta_path[:]=[_S(f) if "editable" in getattr(type(f),"__module__","") else f for f in sys.meta_path]\n' > /tmp/pyfix/sitecustomize.py
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/NaomiEisen/llm-d-rl.git@slime-integration#subdirectory=integrations/common"
                  python3 -c "import llm_d_rl_common" || { echo "FATAL: common package not importable after install"; exit 1; }
                  command -v llm-d-rl-router > /dev/null || { echo "FATAL: llm-d-rl-router not on PATH after installing common"; exit 1; }
                  printf 'endpoints: []\n' > /tmp/epp-endpoints.yaml
                  nohup llm-d-rl-router \
                    --epp-config /etc/llmd-configs/epp-config.yaml \
                    --envoy-config /etc/llmd-configs/envoy.yaml \
                    >> /tmp/router.log 2>&1 &
                  nohup llm-d-registration-shim \
                    --engine-type sglang --id-field id \
                    --host 127.0.0.1 --port 3001 \
                    --endpoints-file /tmp/epp-endpoints.yaml \
                    > /tmp/shim.log 2>&1 &
                  echo "Setup complete" > /tmp/slime_ready.txt
                  echo "=== setup done ==="
                  SETUP

          env:
          - name: HOME
            value: "/tmp"
          - name: USER
            value: "ray"
          - name: MY_POD_IP
            valueFrom:
              fieldRef:
                fieldPath: status.podIP
          - name: PYTHONPATH
            value: "/tmp/pyfix:/tmp/slime-src:/tmp/Megatron-LM"

          # --- HuggingFace cache ---
          - name: HF_HOME
            value: "/tmp/slime/hf_cache"
          - name: HF_DATASETS_CACHE
            value: "/tmp/slime/hf_cache/datasets"
          - name: XDG_CACHE_HOME
            value: "/tmp/slime/hf_cache"
          - name: HUGGINGFACE_HUB_CACHE
            value: "/tmp/slime/hf_cache"

          # --- Compile / framework caches ---
          - name: TRITON_CACHE_DIR
            value: "/tmp/triton"
          - name: FLASHINFER_WORKSPACE_DIR
            value: "/tmp/flashinfer"
          - name: TORCHINDUCTOR_CACHE_DIR
            value: "/tmp/torch_inductor_cache"

          # --- SGLang / NCCL ---
          - name: TOKENIZERS_PARALLELISM
            value: "false"
          - name: OMP_NUM_THREADS
            value: "1"
          - name: RAY_max_grpc_threads
            value: "32"
          - name: NCCL_DEBUG
            value: "INFO"

          # CuMemAllocator (sglang sleep/wake) is incompatible with expandable_segments
          - name: PYTORCH_CUDA_ALLOC_CONF
            value: "expandable_segments:False"

          # --- EPP / Envoy binary paths (filled by the fetch-binaries init container) ---
          # Read by llm_d_rl_common.router_stack, which llm-d-rl-router uses to launch
          # them; neither binary is baked into the image, so bumping IMG_EPP /
          # IMG_ENVOY in deploy.env and recreating the pod is the whole upgrade path.
          - name: LLMD_EPP_BINARY
            value: "/opt/llm-d-bins/epp"
          - name: LLMD_ENVOY_BINARY
            value: "/opt/llm-d-bins/envoy"

          - name: WANDB_MODE
            value: "offline"

          # --- Router verbosity (default: quiet) ---
          # See deploy/kuberay/README.md ## Increasing verbosity.
          # - name: LLMD_EPP_VERBOSITY
          #   value: "5"
          # - name: LLMD_ENVOY_LOG_LEVEL
          #   value: "debug"

          resources:
            limits:
              cpu: "32"
              memory: "256G"
              nvidia.com/gpu: "6"
            requests:
              cpu: "16"
              memory: "128G"
              nvidia.com/gpu: "6"

          ports:
          - containerPort: 6379
            name: gcs-server
          - containerPort: 8265
            name: dashboard
          - containerPort: 10001
            name: client
          - containerPort: 8081
            name: envoy

          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
          - mountPath: /dev/shm
            name: dshm
          - mountPath: /etc/llmd-configs
            name: llmd-epp-configs-slime
            readOnly: true
          - mountPath: /.cache
            name: sglang-cache
          - mountPath: /.triton
            name: triton-cache

        volumes:
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "64Gi"
        - name: llmd-epp-configs-slime
          configMap:
            name: llmd-epp-configs-slime
        - name: llm-d-bins
          emptyDir: {}
        - name: sglang-cache
          emptyDir: {}
        - name: triton-cache
          emptyDir: {}
