# The llm-d routing stack the shipped configs are tested against.
#
# This lives beside the configs on purpose. An EPP config and the EPP build that
# can load it are ONE versioned unit, and keeping them apart has already cost
# this repo twice: two frameworks pinned different EPP digests and their scoring
# results stopped being comparable, and epp/profiles/burst.yaml's
# burst-prefix-cache-producer is Alpha-stability, so the runner hard-fails config
# loading without --allow-experimental-plugins - a fact that had to be
# rediscovered because it was not written down next to the config that needs it.
#
# Sourced by each deploy.sh BEFORE its own deploy.env, so a framework can
# override any of these when it must (slime needs an EPP build carrying
# sglanghttp-parser). Everyone else should inherit.

# EPP: llm-d-inference-scheduler main at 95625abe (2026-08-09). Carries
# balanceBy=tokens on the burst producer and the p2p-source-producer plugin with
# its load-aware / CPU-tier-aware selection fixes.
LLMD_EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker-dev:95625abeed826accc4dfa7903ef34a4d369830d8

# Envoy, for the llm-d-serving and registration-shim paths. Stable.
LLMD_ENVOY_IMAGE=docker.io/envoyproxy/envoy:distroless-v1.33.2

# Sidecar (worker nodes only): translates EPP's source header into vLLM's
# kv_transfer_params. Used by PD decode replicas and by every replica in P2P
# mode. Kept in lockstep with the EPP image - same repo, same commit.
LLMD_SIDECAR_IMAGE=ghcr.io/llm-d/llm-d-router-disagg-sidecar-dev:95625abeed826accc4dfa7903ef34a4d369830d8

# Launch flags the shipped configs require. llm_d_rl_common.router_stack already
# passes --allow-experimental-plugins; this records WHY, so nobody removes it:
# burst-prefix-cache-producer is Alpha stability and EPP refuses the config
# without it.
LLMD_EPP_REQUIRED_FLAGS=--allow-experimental-plugins

# A non-default EPP_PARSER needs an EPP build that actually carries that parser
# plugin. vllmhttp-parser is in the image above; sglanghttp-parser is not yet in
# any published image, which is why slime overrides LLMD_EPP_IMAGE.
LLMD_EPP_PARSER_DEFAULT=vllmhttp-parser
