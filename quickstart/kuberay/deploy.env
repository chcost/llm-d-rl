# Platform config for this KubeRay deployment: values that belong to the cluster
# and to nothing else. Three files are sourced before it, and it may override any:
#
#   llm_d_rl_common/configs/versions.env      EPP / Envoy / sidecar images and the
#                                             flags their configs require
#   integrations/<fw>/environments.env        which environment image goes with
#                                             which framework ref, engine columns
#   frameworks.env                            topology, cluster shape, sizes
#
# NAMESPACE is deliberately NOT set here - it is per-user and comes from the
# environment, so a personal namespace never gets committed. deploy.sh fails fast
# when it is unset.

# One cluster name for every framework, so the label-based pod lookups in
# ../benchmarks/scripts (which all take items[0]) cannot silently target the
# wrong cluster. Two frameworks in one namespace are mutually exclusive by
# construction: applying one replaces the other.
CLUSTER_NAME=llmd-rl-cluster

# Generic registry tool pinned by digest (go-containerregistry crane :debug,
# which ships /busybox/sh + /busybox/tar). Never rebuilt.
IMG_CRANE=gcr.io/go-containerregistry/crane@sha256:1b1fb24d2b1bb27a9daf81a588157e68463876904e8e537a812edba6284fb252

# Search-R1 BM25 retrieval server (verl's searchr1 workload only). CPU-only; runs
# as its own Deployment+Service, applied by `deploy.sh retriever`.
IMG_RETRIEVER=ghcr.io/ezrasilvera/searchr1-retriever:bm25

# Where a local checkout is copied to when provisioning with --from-local.
LLMD_LOCAL_SRC=/tmp/llmd-src
