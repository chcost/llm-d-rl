# vllm: x86_64=0.24.0, aarch64=0.20.2
# Target: verlai/verl:vllm024.dev2

ARG CUDA_VERSION=13.0.2
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

ARG CUDA_VERSION
ARG PYTHON_VERSION=3.12
ARG TORCH_VERSION=2.11.0
ARG TORCH_VISION_VERSION=0.26.0
ARG TORCH_AUDIO_VERSION=2.11.0
ARG TRANSFORMERS_VERSION=5.8.1
ARG VLLM_VERSION=0.24.0
ARG VLLM_COMMIT=beca88e59ea75a7aa1af72a5ae50188fa91d4e3d
ARG VLLM_OMNI_VERSION=0.24.0
ARG TRL_VERSION=0.27.0
ARG TRANSFORMER_ENGINE_VERSION=v2.16.1
ARG FLASH_ATTENTION_VERSION=2.8.3
ARG NSIGHT_VERSION=2025.6.1
ARG MEGATRON_BRIDGE_VERSION_OR_BRANCH=r0.5.0
ARG MCORE_VERSION=core_v0.18.0
ARG TRANSFER_QUEUE_VERSION=0.1.8
ARG VERL_VERSION=v0.7.1
ARG DEBIAN_FRONTEND=noninteractive
ARG PIP_NO_CACHE_DIR=1
ARG APT_MIRROR=""
# PEP 668: Ubuntu 24.04 blocks system-wide pip installs; override for Docker
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s@http://.*archive.ubuntu.com@${APT_MIRROR}@g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi

RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    cmake \
    build-essential \
    libibverbs-dev \
    libnuma-dev \
    librdmacm-dev \
    numactl \
    software-properties-common \
    vim \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    && rm -rf /var/lib/apt/lists/*

RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python${PYTHON_VERSION} get-pip.py && \
    rm get-pip.py

RUN ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python3 && \
    ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python

RUN pip install torch==${TORCH_VERSION} torchvision==${TORCH_VISION_VERSION} torchaudio==${TORCH_AUDIO_VERSION} --index-url https://download.pytorch.org/whl/cu130

RUN pip install pybind11 wheel

# =========================
# Install cuDNN (network repo)
# =========================
RUN ARCH=$(if [ "$(uname -m)" = "aarch64" ]; then echo "sbsa"; else echo "x86_64"; fi) && \
    CUDA_VERSION_MAJOR=$(echo ${CUDA_VERSION} | cut -d '.' -f 1) && \
    wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/${ARCH}/cuda-keyring_1.1-1_all.deb && \
    sed -i '/developer\.download\.nvidia\.com\/compute\/cuda\/repos/d' /etc/apt/sources.list.d/* && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get -y --allow-downgrades --allow-change-held-packages install \
    cudnn9-cuda-${CUDA_VERSION_MAJOR} \
    libcudnn9-cuda-${CUDA_VERSION_MAJOR} \
    libcudnn9-dev-cuda-${CUDA_VERSION_MAJOR} \
    libcudnn9-headers-cuda-${CUDA_VERSION_MAJOR} && \
    rm -f cuda-keyring_1.1-1_all.deb && \
    rm -rf /var/lib/apt/lists/*

RUN pip install nvidia-mathdx ninja

# Debian python3-jwt has no pip RECORD; vllm cannot uninstall it when upgrading PyJWT.
RUN apt-get update && \
    apt-get remove -y --purge python3-jwt 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --ignore-installed PyJWT

# Apply two unmerged vLLM fixes required by verl weight-sync flows by patching in each
# PR's cumulative diff (GitHub ".diff") with `git apply --3way`, rather than cherry-picking
# commits or ranges. These PR branches are periodically rebased and even contain
# "Merge branch 'main'" commits, so a "v${VLLM_VERSION}_fix..pr" range replays hundreds of
# unrelated main commits and aborts on an empty/merge commit. The net diff carries only the
# PR's own changes, so it stays small and stable regardless of how the branch is rebased.
#   #44483: illegal memory access during a partial wake_up (sleep mode).
#   #45589: FlashInfer-TRTLLM MoE load OOM.
#
# Installed HERE, before apex/TransformerEngine/flash-attn/DeepEP below, because this wheel
# has no --no-deps and pulls torch up to whatever it actually needs (2.13.0) - those four are
# compiled extensions built against torch's ABI, so they must build against the FINAL torch,
# not the earlier ${TORCH_VERSION} pin.
RUN pip install -U https://wheels.vllm.ai/${VLLM_COMMIT}/vllm-0.26.1rc1.dev363%2Bgbeca88e59-cp38-abi3-manylinux_2_28_x86_64.whl

RUN MAX_JOBS=256 pip install -v --disable-pip-version-check --no-build-isolation \
    --config-settings "--build-option=--cpp_ext" \
    --config-settings "--build-option=--cuda_ext" \
    git+https://github.com/NVIDIA/apex.git

RUN export NVTE_FRAMEWORK=pytorch && \
    MAX_JOBS=256 NVTE_BUILD_THREADS_PER_JOB=4 \
    pip3 install --resume-retries 999 --no-build-isolation git+https://github.com/NVIDIA/TransformerEngine.git@${TRANSFORMER_ENGINE_VERSION}

    RUN pip install codetiming mathruler pylatexenc cachetools pytest-asyncio

RUN export FLASH_ATTENTION_FORCE_BUILD="TRUE" && MAX_JOBS=32 pip install --no-build-isolation flash_attn==${FLASH_ATTENTION_VERSION}

RUN NSIGHT_VERSION=2025.6.1_2025.6.1.190-1_$(if [ "$(uname -m)" = "aarch64" ]; then echo "arm64"; else echo "amd64"; fi) && \
    wget https://developer.nvidia.com/downloads/assets/tools/secure/nsight-systems/2025_6/nsight-systems-${NSIGHT_VERSION}.deb && \
    apt-get update && apt-get install -y libxcb-cursor0 && \
    apt-get install -y ./nsight-systems-${NSIGHT_VERSION}.deb && \
    rm -rf /usr/local/cuda/bin/nsys && \
    ln -s /opt/nvidia/nsight-systems/2025.6.1/nsys  /usr/local/cuda/bin/nsys && \
    rm -rf /usr/local/cuda/bin/nsys-ui && \
    ln -s /opt/nvidia/nsight-systems/2025.6.1/nsys-ui /usr/local/cuda/bin/nsys-ui && \
    rm nsight-systems-${NSIGHT_VERSION}.deb && \
    rm -rf /var/lib/apt/lists/*

# =========================
# Install DeepEP
# =========================
RUN cd /home && mkdir -p dpsk_a2a && cd dpsk_a2a && \
    git clone -b v2.5.1 https://github.com/NVIDIA/gdrcopy.git && \
    cd gdrcopy && \
    make prefix=/usr/local lib_install && \
    cd .. && rm -rf gdrcopy && \
    git clone -b hybrid-ep https://github.com/deepseek-ai/DeepEP.git && \
    export NVSHMEM_DIR=/usr/local/lib/python3.12/dist-packages/nvidia/nvshmem && \
    export LD_LIBRARY_PATH="${NVSHMEM_DIR}/lib:$LD_LIBRARY_PATH" && \
    export PATH="${NVSHMEM_DIR}/bin:$PATH" && \
    cd ${NVSHMEM_DIR}/lib && \
    ln -sf libnvshmem_host.so.3 libnvshmem_host.so && \
    cd /home/dpsk_a2a/DeepEP && \
    git checkout 3f601f7ac1c062c46502646ff04c535013bfca00 && \
    CUDA_TARGET=$(uname -m | sed 's/aarch64/sbsa-linux/;s/x86_64/x86_64-linux/') && \
    export CPATH=/usr/local/cuda/targets/${CUDA_TARGET}/include/cccl:$CPATH && \
    TORCH_CUDA_ARCH_LIST="9.0;10.0" python setup.py install

# vLLM install (and its python3-jwt cleanup) now happens BEFORE apex/TransformerEngine/
# flash-attn/DeepEP, up above - see the block right after nvidia-mathdx/ninja. Those four are
# all compiled C++/CUDA extensions built against torch's ABI via --no-build-isolation; vLLM's
# wheel install has no --no-deps, so it silently upgrades torch (2.11.0 -> 2.13.0 for this
# wheel) to satisfy its own requirement. Building the extensions AFTER that upgrade, instead
# of before it, means they compile against the torch version that's actually going to run,
# instead of getting invalidated by a later torch bump (this is what broke flash-attn:
# `undefined symbol: ...materialize_cow_storage...` at import time - the .so was linked
# against torch 2.11's C++ ABI, then torch got bumped to 2.13.0 by this same install below it).

RUN pip3 install --no-deps trl==${TRL_VERSION}

RUN pip3 install nvtx matplotlib liger_kernel

RUN pip install transformers==${TRANSFORMERS_VERSION}

RUN pip install -U git+https://github.com/ISEEKYAN/mbridge.git@main

RUN pip install --no-deps --no-build-isolation git+https://github.com/NVIDIA-NeMo/Megatron-Bridge.git@${MEGATRON_BRIDGE_VERSION_OR_BRANCH}

RUN pip install --no-deps --no-build-isolation git+https://github.com/NVIDIA/Megatron-LM.git@${MCORE_VERSION}

ENV PYTHONPATH="/workspace/Megatron-Bridge/3rdparty/Megatron-LM:${PYTHONPATH}"

RUN pip install --no-deps TransferQueue==${TRANSFER_QUEUE_VERSION}

RUN pip install torchcodec --index-url=https://download.pytorch.org/whl/cu130

RUN apt-get update && \
    apt-get install -y ffmpeg && \
    ffmpeg -decoders | grep -i nvidia && \
    rm -rf /var/lib/apt/lists/*

RUN pip install qwen-vl-utils==0.0.14

RUN pip uninstall -y scipy

RUN CUDA_TARGET=$(uname -m | sed 's/aarch64/sbsa-linux/;s/x86_64/x86_64-linux/') && \
    export CPATH=/usr/local/cuda/targets/${CUDA_TARGET}/include/cccl:$CPATH && \
    git clone https://github.com/deepseek-ai/FlashMLA.git flash-mla && \
    cd flash-mla && \
    git submodule update --init --recursive && \
    pip install --no-build-isolation -v .

RUN git clone https://github.com/Dao-AILab/fast-hadamard-transform.git fast-hadamard-transform && \
    cd fast-hadamard-transform && \
    pip install -v --no-build-isolation .

RUN pip install git+https://github.com/verl-project/verl.git@${VERL_VERSION} && pip uninstall -y verl

RUN CUDA_VERSION_MAJOR=$(echo ${CUDA_VERSION} | cut -d '.' -f 1) && \
    CUDNN_PKG=libcudnn9-cuda-${CUDA_VERSION_MAJOR} && \
    CUDNN_VERSION=$(dpkg-query -W -f='${Version}' "${CUDNN_PKG}" 2>/dev/null | sed 's/-[0-9]*$//') && \
    if [ -z "${CUDNN_VERSION}" ]; then \
        CUDNN_HDR=$(find /usr/include -name cudnn_version.h | head -1) && \
        CUDNN_VERSION=$(grep -E '^#define CUDNN_(MAJOR|MINOR|PATCHLEVEL) ' "${CUDNN_HDR}" | awk '{print $3}' | paste -sd. -); \
    fi && \
    pip install "nvidia-cudnn-cu${CUDA_VERSION_MAJOR}==${CUDNN_VERSION}" && \
    pip install nvidia-cudnn-frontend

# Override NCCL to >= 2.29.7 for ncclCommSuspend / ncclCommResume
# (RFC: https://github.com/verl-project/verl/issues/6266).
# TODO(xiefan46): remove once torch pin bumps to >= 2.12.0.
RUN pip install --no-deps --upgrade "nvidia-nccl-cu13>=2.29.7,<3.0"

# vLLM's own [cu13] extra pulls nvidia-cutlass-dsl==4.6.0, whose cutlass.cute.core is missing
# ThrMma - megatron-core's optional FA4/cute import (flash_attn.cute) then dies with a bare
# AttributeError that its own `except ImportError:` guard can't catch, crashing any import of
# megatron.core.transformer.attention (pulled in eagerly by verl's engine package, even when
# only the FSDP engine is used). Pinning 4.5.3 instead does NOT make flash_attn's cute submodule
# actually work (cutlass.utils.ampere_helpers is missing there too) - it fixes the crash because
# THAT failure is a clean ModuleNotFoundError (an ImportError subclass), which the existing
# guard handles correctly (HAVE_FA4=False) instead of propagating. pip will warn about a
# vllm[cu13]==4.6.0 conflict from this downgrade; harmless in practice - verified end-to-end
# training works with this pin. Placed last so nothing above can silently re-resolve it back to
# 4.6.0; must uninstall the mismatched 4.6.0 sibling packages first or a partial/inconsistent
# install results (libs-core/cu12/cu13 staying at 4.6.0 while libs-base drops to 4.5.3).
RUN pip uninstall -y nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base nvidia-cutlass-dsl-libs-core \
        nvidia-cutlass-dsl-libs-cu12 nvidia-cutlass-dsl-libs-cu13 && \
    pip install --no-cache-dir "nvidia-cutlass-dsl==4.5.3"

# --- NIXL + KV-connector fixes (needed by PD and P2P; baked directly into this
# image rather than a separate Dockerfile.pd layered on top, which is how this
# used to work - that meant PD mode's image build defaulted to a separate
# BASE_IMAGE build-arg, verlai/verl:vllm018.dev1, NOT this nightly-fixed image,
# so PD wasn't actually guaranteed to have the flash-attn/transformers/cutlass-dsl
# fixes above unless someone remembered to override that arg. One image now
# covers every mode: native/epp/epp-p2p/PD.) ---

# NIXL for vLLM NixlConnector (P/D KV transfer) and OffloadingConnector's P2P tier
# (both use NIXL as their underlying transport). verl base images do not ship
# kv_connectors deps. Without this, vLLM fails at engine init with:
# RuntimeError: NIXL is not available
RUN pip install "nixl==0.10.1" "nixl-cu12==0.10.1" && \
    python3 -c "from nixl._api import nixl_agent; print('NIXL OK')"

# Fix vLLM's token-in/token-out generate path — forward kv_transfer_params to engine.
# /inference/v1/generate receives kv_transfer_params (do_remote_decode=true for
# NIXL PD, remote_kv_source for P2P) from the llm-d sidecar, but this serving class
# never copies it into sampling_params.extra_args. Both NixlConnector and
# OffloadingConnector read their respective keys from
# sampling_params.extra_args.get("kv_transfer_params") (vLLM's MultiConnector
# dispatches each connector's own sub-keys from that single dict), so without this
# patch it always sees None and no KV cache is transferred. The fix itself is
# generic (any non-empty request.kv_transfer_params gets forwarded) - not gated to
# NIXL's own do_remote_decode key - so it covers P2P's remote_kv_source the same way.
# Confirmed genuinely still needed at this pinned commit (not yet fixed upstream):
# vllm-project/vllm#42644 ("Thread kv_transfer_params into engine for
# /inference/v1/generate (disagg)") is open/unmerged and describes this exact bug.
# File path is `entrypoints/scale_out/token_in_token_out/serving.py` at this nightly
# (older vLLM/verl recipes call the equivalent file `entrypoints/serve/disagg/serving.py`
# - same code shape, just renamed/relocated; verify the path again if bumping VLLM_COMMIT).
# This path is specific to /inference/v1/generate (token-in token-out);
# /v1/chat/completions already forwards kv_transfer_params correctly, which is why
# other deployments work.
RUN sed -i \
    's/        result_generator = self\.engine_client\.generate(/        if request.kv_transfer_params:\n            if sampling_params.extra_args is None:\n                sampling_params.extra_args = {}\n            sampling_params.extra_args["kv_transfer_params"] = request.kv_transfer_params\n\n        result_generator = self.engine_client.generate(/' \
    /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/scale_out/token_in_token_out/serving.py

# NOTE: an earlier version of this Dockerfile also patched scheduler.py/gpu_worker.py/
# abstract.py/engine/core.py to add an external drain_kv_connector() before
# reset_prefix_cache(), working around a NixlConnector notification-drain race on an
# older vLLM. Removed at this pinned commit: (1) 2 of its 4 target lines no longer
# exist verbatim (code restructured), so blindly re-deriving matching patterns would
# be guesswork, not a verified fix; (2) OffloadingConnector (P2P's connector) already
# drains natively - offloading/scheduler.py's own reset_cache() flushes all in-flight
# jobs directly, and vLLM core's _reset_caches() already calls
# reset_prefix_cache(reset_connector=True) by default (a no-op when no connector is
# configured), so the external hack is solving a problem the connector-native path
# now handles internally; (3) general sleep-mode drain robustness has seen real
# upstream work in this same window (vllm-project/vllm#45520, fixed by #45552) -
# a different but adjacent bug class, suggesting this whole area has moved since the
# original patch was written. If PD/NixlConnector specifically still hits a
# notification-drain race on this vLLM version, that needs its own fresh diagnosis,
# not a resurrection of this patch as-is.
