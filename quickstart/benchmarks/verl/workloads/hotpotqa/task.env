# hotpotqa (text, Qwen3-4B): single-turn context-in-prompt QA. Reward = EM
# (data_source=searchR1_hotpotqa, baked into the parquet). Builder: make_hotpotqa.py.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_hotpotqa
DEF_TRAIN=/tmp/verl/data/hotpotqa/train.parquet
DEF_TEST=/tmp/verl/data/hotpotqa/test.parquet
DEF_MAXP=4096; DEF_MAXR=1024
# Raise the dynamic-bsz token budgets above max_prompt+response, else the 4B script's default
# (ppo_max_token_len_per_gpu=3000) trips a max_token_len assertion in the actor update.
TASK_OVERRIDES=(
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=8192
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=8192
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=8192
)
