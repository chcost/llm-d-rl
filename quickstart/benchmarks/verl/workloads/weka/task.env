# weka (trace replay): replays Weka CC-trace conversation SHAPES (per-turn input/
# output token counts + inter-turn off-GPU gaps - there is NO prompt text) through
# verl -> vLLM, routed native or via EPP. The trace_player agent loop synthesizes
# deterministic prefix-nesting prompt_ids per conversation and forces output length
# (max_tokens = min_tokens = out, ignore_eos), so GPU load matches the trace.
# Builder: make_weka.py (needs traces.jsonl; see README for the HuggingFace download).
#
# This workload sets ONLY the loop (default_agent_loop + agent_loop_config_path);
# the ROUTER is chosen by --mode, so `--task weka` runs unchanged under:
#   --mode native   verl GlobalRequestLoadBalancer (sticky per-conversation)
#   --mode epp      EPP routing, stock client (in-flight counter decays at pick)
#   --mode epp-fc   EPP routing + completion signal + inflight config (C-cap capable)
# It deliberately does NOT set agent_loop_manager_class / epp_config_file here, so
# it does not collide with the +overrides those mode arms emit in run_test.sh.
#
# NOTE: mount trace_player_agent_loop.yaml into the /etc/llmd-configs ConfigMap
# (like the epp configs). For non-smoke runs, raise DEF_MAXP/DEF_MAXR (and
# --max-total-tokens at build time) to cover the trace's largest turn.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_weka
DEF_TRAIN=/tmp/verl/data/weka/train.parquet
DEF_TEST=/tmp/verl/data/weka/test.parquet
# Must cover the largest replayed turn (input + output). Smoke-test sizing; raise
# for real runs (and match --max-total-tokens used to build the parquet).
DEF_MAXP=8192; DEF_MAXR=4096
TASK_OVERRIDES=(
  actor_rollout_ref.rollout.agent.default_agent_loop=trace_player
  actor_rollout_ref.rollout.agent.agent_loop_config_path=/etc/llmd-configs/trace_player_agent_loop.yaml
  data.return_raw_chat=True
  # No answer-quality reward (synthetic prompts, no ground truth): a constant
  # reward from the installed package (present on head+workers). Measures timing,
  # not learning. The file ships in the trace_player package (same path on all pods).
  # NOTE: set the reward.-nested key directly - the experimental reward_loop reads
  # config.reward.custom_reward_function (get_custom_reward_fn); the top-level->nested
  # migration does not reach the reward workers in this verl build.
  reward.custom_reward_function.path=/usr/local/lib/python3.12/dist-packages/llm_d_rl_verl_integration/trace_player/dummy_reward.py
  reward.custom_reward_function.name=compute_score
)
