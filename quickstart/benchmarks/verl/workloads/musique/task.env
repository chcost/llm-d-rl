# musique (text, Qwen3-4B): single-turn multi-hop QA (~20 paragraphs/example). Reward = EM
# (data_source=searchR1_musique, baked into the parquet). Builder: make_musique.py.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_musique
DEF_TRAIN=/tmp/verl/data/musique/train.parquet
DEF_TEST=/tmp/verl/data/musique/test.parquet
# max_prompt=5120 keeps ~99.9% of examples (filter_overlong drops the rest).
DEF_MAXP=5120; DEF_MAXR=2048
# Raise token budgets above max_prompt+response, else a max_token_len assertion trips.
TASK_OVERRIDES=(
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=8192
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=8192
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=8192
)
