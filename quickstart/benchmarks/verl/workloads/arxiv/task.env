# arxiv (text, Qwen3-4B): arXiv subject-area classification with a large prompt window and brief
# CoT. Read a full paper, reason briefly inside <think>, then answer with one of 11 arXiv categories.
# Reward = EM (data_source=searchR1_nq, code or name match). Builder: make_arxiv.py
# (ccdv/arxiv-classification, no_ref config, CoT) -> /tmp/verl/data/arxiv.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_arxiv
DEF_TRAIN=/tmp/verl/data/arxiv/train.parquet
DEF_TEST=/tmp/verl/data/arxiv/test.parquet
# max_prompt 24576 to include a large slice of each paper; response 2048 (non-clipping CoT).
DEF_MAXP=24576; DEF_MAXR=2048
# filter_overlong + truncation=right drop/clip the long paper tail (keeping the head - title,
# abstract, intro - where subject-area signal concentrates) instead of crashing; raise token
# budgets above max_prompt+response, else a max_token_len assertion trips.
TASK_OVERRIDES=(
  data.filter_overlong_prompts=True
  data.truncation=right
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=28672
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=28672
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=28672
)
