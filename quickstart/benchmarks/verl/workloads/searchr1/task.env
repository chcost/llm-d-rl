# searchr1 (text, Qwen3-4B): multi-turn agentic Search-R1 - the model interleaves <think> with
# `search` tool calls (BM25 retriever over wiki-18) and emits a final <answer>. Reward = EM
# (data_source=searchR1_hotpotqa, baked into the parquet). Builder: make_searchr1.py. Needs the
# retriever service (retriever/) and the tool config (tool_config.yaml, mounted into the ConfigMap).
#
# Activation: default_agent_loop=tool_agent selects verl's ToolAgentLoop; format=hermes is Qwen3's
# tool-call format (the chat template injects the tool schema); tool_config_path is the mounted config.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_searchr1
DEF_TRAIN=/tmp/verl/data/searchr1/train.parquet
DEF_TEST=/tmp/verl/data/searchr1/test.parquet
# DEF_MAXR is large: it must cover ALL turns' generations plus the appended tool observations.
DEF_MAXP=2048; DEF_MAXR=4096
TASK_OVERRIDES=(
  actor_rollout_ref.rollout.agent.default_agent_loop=tool_agent
  actor_rollout_ref.rollout.multi_turn.enable=True
  actor_rollout_ref.rollout.multi_turn.format=hermes
  actor_rollout_ref.rollout.multi_turn.tool_config_path=/etc/llmd-configs/searchr1_tool_config.yaml
  actor_rollout_ref.rollout.multi_turn.max_assistant_turns=4
  actor_rollout_ref.rollout.multi_turn.max_user_turns=4
  actor_rollout_ref.rollout.multi_turn.max_parallel_calls=1
  actor_rollout_ref.rollout.multi_turn.max_tool_response_length=512
  data.return_raw_chat=True
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=12288
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=12288
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=12288
)
