# scotus_xl (text, Qwen3-4B): SCOTUS issue-area classification with a larger prompt window and brief
# CoT. Read a full opinion, reason briefly inside <think>, then answer with one of 13 labels.
# Reward = EM (data_source=searchR1_nq, code or name match). Builder: make_scotus.py
# (CoT) -> /tmp/verl/data/scotus_xl_cot.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_scotus_xl
DEF_TRAIN=/tmp/verl/data/scotus_xl_cot/train.parquet
DEF_TEST=/tmp/verl/data/scotus_xl_cot/test.parquet
# max_prompt 24576 to include more of the real opinions; response 2048 (non-clipping CoT).
DEF_MAXP=24576; DEF_MAXR=2048
# filter_overlong + truncation=right drop/clip the long opinion tail instead of crashing;
# raise token budgets above max_prompt+response, else a max_token_len assertion trips.
TASK_OVERRIDES=(
  data.filter_overlong_prompts=True
  data.truncation=right
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=28672
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=28672
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=28672
)
