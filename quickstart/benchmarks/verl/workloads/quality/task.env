# quality (text, Qwen3-4B): QuALITY long-context multiple-choice. Reward = EM
# (data_source=searchR1_nq alias, letter match, baked into the parquet). Builder: make_quality.py.
FSDP_SCRIPT=run_qwen3_4b_fsdp.sh
DEF_MODEL=/tmp/verl/models/Qwen3-4B
DEF_PROJECT=verl_grpo_quality
DEF_TRAIN=/tmp/verl/data/quality/train.parquet
DEF_TEST=/tmp/verl/data/quality/test.parquet
# max_prompt=8192 keeps 100% (max 7668 + chat template < 8192); response cap 2048.
DEF_MAXP=8192; DEF_MAXR=2048
# data.shuffle is env-controlled (QUALITY_SHUFFLE, default True).
# Raise token budgets above max_prompt+response, else a max_token_len assertion trips.
TASK_OVERRIDES=(
  data.shuffle=${QUALITY_SHUFFLE:-True}
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu=12288
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu=12288
  actor_rollout_ref.ref.log_prob_max_token_len_per_gpu=12288
)
